# Copy this file to .env and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard).
# Without these, the app still works fully in solo mode; "Sfida online"
# will show a "backend non configurato" message instead of crashing.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
